{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "marey",
  "version": "0.1.0",
  "identifier": "com.mdiazn80.marey",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "marey",
        "width": 800,
        "height": 600,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "",
      "endpoints": [
        "https://github.com/mdiazn80/marey/releases/latest/download/latest.json"
      ]
    }
  }
}